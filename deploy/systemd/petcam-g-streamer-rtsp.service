[Unit]
Description=PetCam always-on GStreamer RTSP camera service
Documentation=https://github.com/mintymelinda/petcam
Before=petcam-stream.service
Wants=network-online.target petcam-rtsp-sampler.service

[Service]
Type=simple
ExecStart=/opt/petcam/venv/bin/python -m petcam.infrastructure.streaming.gstreamer
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=0
Nice=10
CPUWeight=20
CPUQuota=80%
MemoryHigh=192M
MemoryMax=256M

[Install]
WantedBy=multi-user.target
