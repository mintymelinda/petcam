[Unit]
Description=PetCam always-on GStreamer RTSP camera service
Documentation=https://github.com/mintymelinda/petcam
After=network-online.target petcam-stream.service
Wants=network-online.target petcam-rtsp-sampler.service

[Service]
Type=simple
Environment=PYTHONPATH=/opt/petcam/current/lib
ExecStart=/usr/bin/python3 -m petcam.infrastructure.streaming.gstreamer
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=0
Nice=10
CPUWeight=20
CPUQuota=80%
MemoryHigh=192M
MemoryMax=256M

[Install]
WantedBy=multi-user.target
