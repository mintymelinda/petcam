[Unit]
Description=Optional PetCam Home Assistant MQTT discovery publisher
After=network-online.target petcam-stream.service petcam-web.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/petcam/current/lib
Environment=PYTHONPATH=/opt/petcam/current/lib
ExecStart=/usr/bin/python3 -m petcam.features.home_assistant.worker
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
