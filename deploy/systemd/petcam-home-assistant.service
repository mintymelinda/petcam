[Unit]
Description=Optional PetCam Home Assistant MQTT discovery publisher
After=network-online.target petcam-stream.service petcam-web.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/petcam/venv/bin/python -m petcam.features.home_assistant.worker
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
