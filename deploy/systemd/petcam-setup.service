[Unit]
Description=PetCam lightweight setup portal and Web UI gateway
Documentation=https://github.com/mintymelinda/petcam
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONPATH=/opt/petcam/current/lib
ExecStart=/usr/bin/python3 -m petcam.api.setup_stub
Restart=always
RestartSec=5
UMask=0007
Nice=5
CPUWeight=5
CPUQuota=3%
MemoryHigh=24M
MemoryMax=40M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/petcam

[Install]
WantedBy=multi-user.target
