[Unit]
Description=PetCam optional full HTTPS web manager
Documentation=https://github.com/mintymelinda/petcam
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/petcam/venv/bin/python -m petcam.api.application
Restart=on-failure
RestartSec=5
UMask=0007
Nice=10
CPUWeight=10
CPUQuota=40%
MemoryHigh=192M
MemoryMax=256M

[Install]
WantedBy=multi-user.target
