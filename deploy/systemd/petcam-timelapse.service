[Unit]
Description=PetCam timelapse capture from the shared RTSP sampler
After=network-online.target remote-fs.target petcam-stream.service petcam-rtsp-sampler.service
Wants=network-online.target petcam-rtsp-sampler.service

[Service]
Type=simple
ExecStart=/opt/petcam/venv/bin/python -m petcam.features.timelapse.worker
Restart=on-failure
RestartSec=5
Nice=10
CPUWeight=10
CPUQuota=25%
MemoryMax=96M
IOSchedulingClass=idle
IOSchedulingPriority=7
