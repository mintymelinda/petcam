[Unit]
Description=PetCam timelapse capture from the active MJPEG stream
After=network-online.target remote-fs.target petcam-stream.service petcam-rtsp-sampler.service
Wants=network-online.target petcam-rtsp-sampler.service

[Service]
Type=simple
Environment=PYTHONPATH=/opt/petcam/current/lib
ExecStart=/usr/bin/python3 -m petcam.features.timelapse.worker
Restart=on-failure
RestartSec=5
Nice=10
CPUWeight=10
CPUQuota=25%
MemoryMax=96M
IOSchedulingClass=idle
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
