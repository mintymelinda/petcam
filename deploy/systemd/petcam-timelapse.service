[Unit]
Description=PetCam timelapse capture from the active MJPEG stream
After=network-online.target remote-fs.target petcam-stream.service petcam-web.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/petcam/current/lib/timelapse.py
Restart=on-failure
RestartSec=5
Nice=10
CPUWeight=10
CPUQuota=25%
MemoryMax=96M
IOSchedulingClass=idle
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
