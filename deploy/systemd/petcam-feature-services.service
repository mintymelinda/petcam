[Unit]
Description=PetCam optional feature service supervisor
Documentation=https://github.com/mintymelinda/petcam
After=network-online.target petcam-g-streamer-rtsp.service petcam-rtsp-sampler.service
Wants=network-online.target petcam-g-streamer-rtsp.service petcam-rtsp-sampler.service

[Service]
Type=simple
ExecStart=/opt/petcam/venv/bin/python -m petcam.infrastructure.system.feature_services
Restart=always
RestartSec=5
Nice=10
CPUWeight=5
CPUQuota=5%
MemoryHigh=48M
MemoryMax=64M

[Install]
WantedBy=multi-user.target
