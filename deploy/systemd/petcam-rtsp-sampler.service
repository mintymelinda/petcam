[Unit]
Description=PetCam shared RTSP frame sampler for motion and timelapse
Documentation=https://github.com/mintymelinda/petcam
After=network-online.target petcam-g-streamer-rtsp.service
Wants=network-online.target petcam-g-streamer-rtsp.service

[Service]
Type=simple
Environment=PYTHONPATH=/opt/petcam/current/lib
ExecStart=/usr/bin/python3 -m petcam.infrastructure.streaming.sampler
Restart=always
RestartSec=3
UMask=0007
Nice=10
CPUWeight=20
CPUQuota=50%
MemoryHigh=160M
MemoryMax=224M

[Install]
WantedBy=multi-user.target
