[Unit]
Description=PetCam low-resource motion detection and event snapshots
After=network-online.target petcam-stream.service petcam-rtsp-sampler.service
Wants=network-online.target petcam-rtsp-sampler.service

[Service]
Type=simple
Environment=PYTHONPATH=/opt/petcam/current/lib
ExecStart=/usr/bin/python3 -m petcam.features.motion.worker
Restart=on-failure
RestartSec=5
Nice=19
CPUWeight=5
CPUQuota=10%
MemoryHigh=48M
MemoryMax=64M
IOSchedulingClass=idle
IOSchedulingPriority=7
